# Copy this file to backend/.env for local backend secrets.
# Do not commit real secrets.

SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Runtime configuration. Cloud Run provides PORT automatically.
PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4201
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SOCKET_TIMEOUT_SECONDS=30
